/*
 * Minimal Orthanc configuration for the Medical Imaging AI project.
 * Run manually (no admin rights needed):
 *   "C:\Program Files\Orthanc Server\Orthanc.exe" D:\orthanc-config.json
 * (copy to a path without spaces - argument quoting with spaces is unreliable)
 *
 * Matches backend/app/services/orthanc_worker.py:
 *   HTTP :8042, basic auth orthanc/orthanc (demo credentials only -
 *   change before any non-local use).
 */
{
  "Name": "MedicalImagingAI",
  "DicomAet": "MEDIMGAI",
  "DicomPort": 4242,
  "HttpPort": 8042,
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "orthanc": "orthanc"
  },
  "DicomModalities": {},
  "DicomTlsEnabled": false,
  "StorageDirectory": "D:/AI-Assisted Medical Imaging and Diagnosis System/orthanc-data/storage",
  "IndexDirectory": "D:/AI-Assisted Medical Imaging and Diagnosis System/orthanc-data/index"
}
